# Copie para .env na raiz do projeto (no servidor) e preencha.
# Gere senhas/chaves com:  openssl rand -base64 48

DB_NAME=sige
DB_USER=sige
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

DEBUG=False
DJANGO_SECRET_KEY=gere-uma-chave-secreta-longa-e-aleatoria

# Endereço pelo qual o sistema será acessado.
# EC2 sem domínio: use o IPv4 público da instância, ex.:
#   ALLOWED_HOSTS=54.123.45.67
#   CSRF_TRUSTED_ORIGINS=http://54.123.45.67
#   SECURE_COOKIES=False          (obrigatório enquanto não houver HTTPS)
# Com domínio e HTTPS:
#   ALLOWED_HOSTS=seu-dominio.example.com
#   CSRF_TRUSTED_ORIGINS=https://seu-dominio.example.com
#   SECURE_COOKIES=True
ALLOWED_HOSTS=seu-dominio.example.com
CSRF_TRUSTED_ORIGINS=https://seu-dominio.example.com
SECURE_COOKIES=True
# Front e API ficam no mesmo endereço (o nginx repassa /api), então CORS pode ficar vazio.
CORS_ALLOWED_ORIGINS=

# t3.small (2 GB): 2 workers é suficiente.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
APP_PORT=80
